generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js ───────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  clients       Client[]
  sales         Sale[]
  loans         Loan[]
  transactions  Transaction[]
  categories    Category[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domínio ───────────────────────────────────────────────────────────────

model Client {
  id        String    @id @default(cuid())
  userId    String
  name      String
  phone     String
  cpf       String
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales Sale[]
  loans Loan[]

  @@unique([userId, cpf])
  @@index([userId, deletedAt])
}

enum SaleType {
  ITEMS
  DIRECT_VALUE
}

model Sale {
  id          String    @id @default(cuid())
  userId      String
  clientId    String
  type        SaleType
  description String?
  saleDate    DateTime  @db.Date
  notes       String?
  totalValue  Decimal   @db.Decimal(12, 2)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id])
  items        SaleItem[]
  installments Installment[]

  @@index([userId, deletedAt])
  @@index([clientId])
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  name       String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Installment {
  id        String            @id @default(cuid())
  saleId    String
  number    Int
  value     Decimal           @db.Decimal(12, 2)
  dueDate   DateTime          @db.Date
  status    InstallmentStatus @default(PENDING)
  paidAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  payment      Payment?
  transactions Transaction[]

  @@index([saleId])
  @@index([status, dueDate])
}

model Payment {
  id            String    @id @default(cuid())
  installmentId String    @unique
  paymentDate   DateTime  @db.Date
  value         Decimal   @db.Decimal(12, 2)
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  installment Installment @relation(fields: [installmentId], references: [id])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionOrigin {
  MANUAL
  INSTALLMENT_PAYMENT
  LOAN_DISBURSEMENT
  LOAN_PAYMENT
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  type          TransactionType
  origin        TransactionOrigin @default(MANUAL)
  description   String
  categoryId    String?
  value         Decimal           @db.Decimal(12, 2)
  date          DateTime          @db.Date
  notes         String?
  installmentId String?
  loanPaymentId String?
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id])
  installment Installment? @relation(fields: [installmentId], references: [id])
  loanPayment LoanPayment? @relation(fields: [loanPaymentId], references: [id])

  @@index([userId, deletedAt])
  @@index([userId, date])
  @@index([type])
}

// ─── Empréstimos ───────────────────────────────────────────────────────────

enum LoanStatus {
  ACTIVE
  SETTLED
  CANCELLED
}

enum LoanPaymentType {
  INTEREST_ONLY
  INTEREST_AND_PARTIAL
  FULL_SETTLEMENT
}

model Loan {
  id               String     @id @default(cuid())
  userId           String
  clientId         String
  principal        Decimal    @db.Decimal(12, 2)
  remainingBalance Decimal    @db.Decimal(12, 2)
  interestRate     Decimal    @db.Decimal(7, 2)
  paymentDay       Int
  loanDate         DateTime   @db.Date
  notes            String?
  status           LoanStatus @default(ACTIVE)
  settledAt        DateTime?
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client        @relation(fields: [clientId], references: [id])
  payments LoanPayment[]

  @@index([userId, deletedAt])
  @@index([clientId])
  @@index([status])
}

model LoanPayment {
  id             String          @id @default(cuid())
  loanId         String
  paymentDate    DateTime        @db.Date
  type           LoanPaymentType
  totalValue     Decimal         @db.Decimal(12, 2)
  interestValue  Decimal         @db.Decimal(12, 2)
  principalValue Decimal         @db.Decimal(12, 2)
  balanceBefore  Decimal         @db.Decimal(12, 2)
  balanceAfter   Decimal         @db.Decimal(12, 2)
  interestRate   Decimal         @db.Decimal(7, 2)
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())

  loan         Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([loanId])
  @@index([paymentDate])
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CategoryType
  deletedAt DateTime?
  createdAt DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name, type])
  @@index([userId, deletedAt])
}
